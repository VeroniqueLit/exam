<Window x:Class="exam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:exam.ViewModels"
        Title="Билет 8 - Рисование прямоугольников" Height="600" Width="900">

    <!-- Привязка ViewModel -->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">

            <!-- Кнопка удаления -->
            <Button Content="Удалить все объекты" 
                    Command="{Binding DeleteAllCommand}" 
                    Padding="10,5" FontWeight="Bold"/>
        </StackPanel>

        <!-- Область для рисования -->
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" Margin="10">
            <ItemsControl ItemsSource="{Binding Rectangles}">
                
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="White" MouseDown="Canvas_MouseDown"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Width="{Binding Width}" 
                                   Height="{Binding Height}" 
                                   Fill="{Binding Color}" 
                                   Stroke="Black" 
                                   StrokeThickness="1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>